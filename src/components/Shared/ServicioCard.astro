---
import type { IconType } from "react-icons";
export interface Props {
  title: string;
  description: string;
  icon: IconType;
}

const { title, description, icon: Icon } = Astro.props;
---

<div
  class="group card bg-white w-full shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 border border-slate-200/80 hover:border-amber-200/50"
  data-aos="fade-up"
  data-aos-delay="150"
  data-aos-duration="800"
>
  <figure class="pt-8 pb-2 flex justify-center">
    <div
      class="w-16 h-16 rounded-2xl bg-amber-50 flex items-center justify-center transition-all duration-300 group-hover:bg-amber-100 group-hover:shadow-lg group-hover:shadow-amber-200/50 group-hover:scale-110"
    >
      <Icon className="text-3xl text-amber-500 transition-all duration-300 group-hover:scale-110" />
    </div>
  </figure>

  <div class="card-body items-center text-center pt-2 px-6 pb-8">
    <h2
      class="card-title text-lg md:text-xl font-bold text-slate-800 transition-colors duration-300 group-hover:text-amber-600"
    >
      {title}
    </h2>
    <div
      class="w-10 h-0.5 rounded-full bg-amber-200 transition-all duration-300 group-hover:w-16 group-hover:bg-amber-400"
    />
    <p
      class="text-slate-500 font-light text-sm leading-relaxed transition-colors duration-300 group-hover:text-slate-600"
    >
      {description}
    </p>
  </div>
</div>
