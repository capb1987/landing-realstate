---
export interface Props {
  rating: number;
}
const { rating } = Astro.props;
const clampedRating = Math.min(Math.max(Math.round(rating), 0), 5);
---

<div
  class="rating justify-center gap-0.5"
  role="img"
  aria-label={`Calificación ${clampedRating} de 5 estrellas`}
>
  {
    Array.from({ length: clampedRating }, (_, i) => (
      <div class="mask mask-star bg-orange-400" aria-hidden="true" />
    ))
  }
  {
    Array.from({ length: 5 - clampedRating }, (_, i) => (
      <div class="mask mask-star bg-slate-300" aria-hidden="true" />
    ))
  }
</div>
