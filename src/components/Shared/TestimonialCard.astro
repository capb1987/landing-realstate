---
import type { testimonial } from "@/types";
import { testimonialImage_text as benefits } from "@/data/testimonial";
import RatingComponent from "@/components/Shared/RatingComponent.astro";
import { Image } from "astro:assets";

export interface Props {
  item: testimonial;
}

const { item } = Astro.props;
const idx = item.id - 1;
const imageSrc = benefits.images[idx] ?? benefits.images[0];
const quote = benefits.benefits[idx] ?? benefits.benefits[0];
const rating = benefits.ratings?.[idx] ?? 5;
const firstName = item.firstName || "Usuario";
const lastName = item.lastName || "";
const fullName = `${firstName} ${lastName}`;
const initials =
  `${firstName[0] ?? ""}${lastName[0] ?? ""}`.toUpperCase() || "?";
const genderLabel = firstName.endsWith("a")
  ? "Cliente verificada"
  : "Cliente verificado";
---

<div
  class="group card bg-white w-full shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 border border-slate-200/80"
  data-aos="fade-up"
  data-aos-delay="100"
  data-aos-duration="800"
>
  <div class="card-body p-5 md:p-6">
    <div
      class="text-amber-200 text-5xl leading-none mb-1 select-none font-serif"
    >
      &ldquo;
    </div>

    <blockquote
      class="text-sm md:text-base text-slate-600 leading-relaxed italic"
    >
      {quote}
    </blockquote>

    <div class="mt-2">
      <RatingComponent rating={rating} />
    </div>

    <div class="divider my-2 md:my-3"></div>

    <div class="flex items-center gap-3">
      <div class="relative shrink-0 w-12 h-12" data-avatar-fallback>
        <Image
          src={imageSrc}
          alt={fullName}
          width={96}
          height={96}
          class="w-12 h-12 rounded-full object-cover object-center ring-2 ring-amber-200 group-hover:ring-amber-400 transition-all duration-300 group-hover:scale-110"
          loading="lazy"
        />
        <div
          class="fallback hidden w-12 h-12 rounded-full bg-amber-100 ring-2 ring-amber-200 items-center justify-center absolute inset-0"
        >
          <span class="text-amber-600 font-bold text-sm">{initials}</span>
        </div>
      </div>
      <div>
        <p class="font-semibold text-slate-800 text-sm leading-tight">
          {fullName}
        </p>
        <p class="text-xs text-slate-500">{genderLabel}</p>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll("[data-avatar-fallback]").forEach((container) => {
    const img = container.querySelector("img");
    const fallback = container.querySelector(".fallback");
    if (img && fallback) {
      img.addEventListener("error", () => {
        img.style.display = "none";
        fallback.classList.remove("hidden");
      });
    }
  });
</script>
