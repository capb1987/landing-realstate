---
import { itemsData as dataNav } from "@/data";
import { Image } from "astro:assets";
import HeaderLink from "@/components/Shared/HeaderLink.astro";
import logo from "@/assets/logoRealState.png";
---

<header class="fixed top-0 w-full z-100 bg-[#3B4A53] shadow-md">
  <div class="navbar container mx-auto lg:max-w-6xl">
    <div class="navbar-start">
      <details class="dropdown lg:hidden">
        <summary
          class="btn btn-ghost"
          aria-label="Abrir menú de navegación"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h8m-8 6h16"></path>
          </svg>
        </summary>
        <ul
          class="menu menu-sm dropdown-content mt-6 z-1 p-2 shadow bg-[#3B4A53] rounded-box w-52"
        >
          {dataNav.map((item) => <HeaderLink item={item} />)}
        </ul>
      </details>

      <a href="/" class="transition-transform hover:scale-105">
        <Image
          width={160}
          height={160}
          class="w-10 sm:w-16 lg:w-20"
          src={logo}
          alt="Smart House - Inicio"
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1 gap-2">
        {
          dataNav.map((item) => (
            <li>
              <HeaderLink item={item} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="navbar-end">
      <a
        href="#contacto"
        data-target="#contacto"
        data-active-class="text-white"
        data-inactive-class="text-slate-900"
        class="links-nav bg-amber-400 hover:bg-amber-500 text-slate-900 uppercase px-2 md:px-4 py-2 font-bold rounded-lg transition-all text-xs sm:text-base text-center"
      >
        Agendar Cita
      </a>
    </div>
  </div>
</header>

<script>
  type ActiveTarget = string | null;
  type SectionMap = Map<string, HTMLElement>;
  type SectionSet = Set<HTMLElement>;

  const OBSERVER_OPTIONS: IntersectionObserverInit = {
    rootMargin: "-35% 0px -60% 0px",
  };

  let activeTarget: ActiveTarget = null;
  let observer: IntersectionObserver | null = null;
  let lastClickTime = 0;

  function getLinks() {
    return [...document.querySelectorAll<HTMLAnchorElement>("a[data-target]")];
  }

  function setActive(target: ActiveTarget) {
    if (target === activeTarget) return;
    activeTarget = target;

    getLinks().forEach((link) => {
      const isActive = link.dataset.target === target;
      const activeClass = link.dataset.activeClass;
      const inactiveClass = link.dataset.inactiveClass;
      if (activeClass) link.classList.toggle(activeClass, isActive);
      if (inactiveClass) link.classList.toggle(inactiveClass, !isActive);
    });
  }

  // Resalta de inmediato al hacer clic en un enlace del menú
  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>(
      "a[data-target]",
    );
    if (!link) return;
    const target = link.dataset.target;
    if (target) {
      lastClickTime = Date.now();
      setActive(target);
    }
    // Cierra el menú móvil (patrón <details>/<summary>)
    const menu = link.closest<HTMLDetailsElement>("details.dropdown");
    if (menu) menu.removeAttribute("open");
  });

  // Logo: en home hace scroll arriba sin recargar la página
  document.addEventListener("click", (e) => {
    const logo = (e.target as HTMLElement).closest<HTMLAnchorElement>(
      'a[href="/"]',
    );
    if (!logo) return;
    if (window.location.pathname !== "/") return;
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: "smooth" });
    history.replaceState(null, "", window.location.pathname);
  });

  function setupActiveNav() {
    observer?.disconnect();
    observer = null;
    activeTarget = null;

    const sections: SectionMap = new Map<string, HTMLElement>();
    getLinks().forEach((link) => {
      const target = link.dataset.target;
      if (!target) return;
      const section = document.querySelector<HTMLElement>(target);
      if (section) sections.set(target, section);
    });

    if (sections.size === 0) return;

    const intersecting: SectionSet = new Set<HTMLElement>();

    const navObserver = new IntersectionObserver(
      (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            intersecting.add(entry.target as HTMLElement);
          } else {
            intersecting.delete(entry.target as HTMLElement);
          }
        });

        let next: HTMLElement | undefined;
        let top = Infinity;
        intersecting.forEach((section) => {
          const rectTop = section.getBoundingClientRect().top;
          if (rectTop < top) {
            top = rectTop;
            next = section;
          }
        });

        if (next) {
          setActive(next.id === "contacto" ? "#contacto" : `#${next.id}`);
        } else if (Date.now() - lastClickTime > 600) {
          setActive(null);
        }
      },
      OBSERVER_OPTIONS,
    );

    observer = navObserver;
    sections.forEach((section) => navObserver.observe(section));
  }

  // Se re-ejecuta en cada navegación (vuelta del blog/inmueble incluida)
  document.addEventListener("astro:page-load", setupActiveNav);
</script>
