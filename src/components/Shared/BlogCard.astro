---
import type { CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data } = post;
const fecha = new Date(data.fecha).toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const badge = data.tags?.[0] ?? null;

import { Image } from "astro:assets";
---

<div
  class="group card bg-base-100 w-full shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 overflow-hidden border border-base-200"
  data-aos="fade-up"
  data-aos-delay="150"
  data-aos-duration="800"
>
  <figure class="relative overflow-hidden aspect-4/3">
    <Image
      width={640}
      height={480}
      src={data.imagen}
      class="w-full h-full object-cover object-center mask-b-from-90%"
      alt={data.titulo}
      loading="lazy"
      decoding="async"
    />

    <div
      class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    >
    </div>
    {
      badge && (
        <span class="absolute top-3 left-3 badge badge-warning text-black text-xs font-semibold uppercase tracking-wider border-0">
          {badge}
        </span>
      )
    }
  </figure>

  <div class="card-body p-5">
    <div class="flex items-center gap-2 text-xs text-base-content/70">
      <span class="font-medium truncate">{data.autor}</span>
    </div>

    <h2
      class="card-title text-lg md:text-xl font-bold leading-snug group-hover:text-warning transition-colors duration-200"
    >
      {data.titulo}
    </h2>

    <p class="text-sm text-base-content/75 line-clamp-3 leading-relaxed">
      {data.descripcion}
    </p>

    <div class="card-actions pt-3">
      <a
        rel="prefetch"
        href={`/blog/${post.id}`}
        class="link link-warning font-semibold uppercase tracking-wider text-xs flex items-center gap-1.5 group/btn transition-all duration-200"
      >
        Leer más
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5 transition-transform duration-200 group-hover/btn:translate-x-1"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>
  </div>
</div>
