---
import BlogCard from "@/components/Shared/BlogCard.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  current: CollectionEntry<"blog">;
  all: CollectionEntry<"blog">[];
}

const { current, all } = Astro.props;
const currentTags = new Set(current.data.tags);

const related = all
  .filter((post) => post.id !== current.id)
  .map((post) => ({
    post,
    matches: post.data.tags.filter((tag) => currentTags.has(tag)).length,
  }))
  .sort((a, b) => b.matches - a.matches)
  .slice(0, 3);
---

{
  related.length > 0 && (
    <section class="mt-20" data-aos="fade-up">
      <h2 class="text-3xl font-bold text-center mb-10">
        Artículos relacionados
      </h2>
      <div
        class={`grid grid-cols-1 md:grid-cols-2  ${related.length > 2 ? "xl:grid-cols-3" : null} gap-6 items-center`}
      >
        {related.map(({ post }) => (
          <BlogCard post={post} />
        ))}
      </div>
    </section>
  )
}
