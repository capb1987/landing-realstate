---
import heroImg from "@/img/heroImg.jpg";
import edificioBg from "@/img/parallax.webp";
import { Image, getImage } from "astro:assets";
import { IoIosContact, IoMdHome } from "react-icons/io";

const parallaxPreload = await getImage({
  src: edificioBg,
  widths: [640, 1080, 1920],
  sizes: "100vw",
  format: "webp",
});
---
<link
  rel="preload"
  as="image"
  href={parallaxPreload.src}
  imagesrcset={parallaxPreload.srcSet.attribute}
  imagesizes="100vw"
  fetchpriority="high"
/>

<section
  class="relative overflow-hidden min-h-svh md:min-h-dvh flex items-center"
>
  <div class="absolute inset-0 z-0">
    <Image
      src={edificioBg}
      alt=""
      widths={[640, 1080, 1920]}
      sizes="100vw"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div
      class="absolute inset-0 bg-linear-to-r from-slate-900/95 via-slate-900/70 to-slate-900/30"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"
    >
    </div>
  </div>

  <div class="relative z-10 container mx-auto px-4 md:px-8 lg:px-12 max-w-7xl">
    <div
      class="scroll-mt-16 md:scroll-mt-20 mt-20 grid md:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-center min-h-dvh pt-40 md:pt-0 pb-20 md:pb-0"
    >
      <div class="text-center md:text-left">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-400 text-xs md:text-sm font-semibold uppercase tracking-[0.15em]"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"
          ></span>
          Bienes Raíces
        </div>

        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white leading-[1.1]"
        >
          Encuentra el lugar donde
          <span
            class="text-transparent bg-clip-text bg-linear-to-r from-amber-300 to-amber-500"
          >
            tu historia comienza.
          </span>
        </h1>

        <p
          class="py-5 md:py-6 text-base md:text-lg lg:text-xl text-slate-300 max-w-lg mx-auto md:mx-0 leading-relaxed"
        >
          Te acompañamos en el proceso de comprar o rentar tu propiedad ideal
          con asesoría personalizada y transparencia total
        </p>

        <div
          class="flex flex-col sm:flex-row gap-3 md:gap-4 justify-center md:justify-start"
        >
          <a
            href="#propiedades"
            class="group relative inline-flex items-center justify-center gap-2.5 px-8 py-3.5 md:py-4 bg-linear-to-r from-amber-400 to-amber-500 text-slate-900 font-bold uppercase text-sm md:text-base rounded-xl overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/30 hover:scale-[1.03] active:scale-[0.97]"
          >
            <span
              class="absolute inset-0 bg-linear-to-r from-white/0 via-white/20 to-white/0 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
            ></span>
            <span class="relative z-10 flex items-center gap-2">
              <IoMdHome className="text-xl md:text-2xl" /> Ver Propiedades
            </span>
          </a>

          <a
            href="#contacto"
            class="group relative inline-flex items-center justify-center gap-2.5 px-8 py-3.5 md:py-4 border-2 border-white/20 text-white font-bold uppercase text-sm md:text-base rounded-xl overflow-hidden transition-all duration-300 hover:bg-white/10 hover:border-white/40 hover:shadow-xl active:scale-[0.97]"
          >
            <span class="relative z-10 flex items-center gap-2">
              <IoIosContact className="text-xl md:text-2xl" /> Contáctanos
            </span>
          </a>
        </div>
      </div>

      <div
        class="hidden md:flex justify-center items-center"
      >
        <div class="relative group">
          <div
            class="absolute -inset-3 bg-linear-to-br from-amber-400/20 to-blue-800/20 rounded-3xl blur-2xl opacity-70 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>
          <div
            class="relative rounded-2xl overflow-hidden shadow-2xl shadow-black/40 border border-white/10"
          >
            <Image
              width={600}
              height={750}
              src={heroImg}
              class="w-full h-auto max-w-sm lg:max-w-md xl:max-w-lg object-cover scale-100 group-hover:scale-105 transition-transform duration-700"
              alt="Propiedades"
              loading="eager"
              decoding="async"
            />
            <div
              class="absolute bottom-0 left-0 right-0 h-1/2 bg-linear-to-t from-slate-900/60 to-transparent"
            >
            </div>
          </div>
          <div
            class="absolute -bottom-3 -left-3 flex items-center gap-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl px-4 py-3 shadow-xl"
          >
            <div class="flex -space-x-2">
              <div
                class="w-8 h-8 rounded-full bg-linear-to-br from-amber-400 to-amber-600 border-2 border-white/30 flex items-center justify-center text-xs font-bold text-slate-900"
              >
                +
              </div>
            </div>
            <div>
              <p class="text-white text-sm font-bold">+15 años</p>
              <p class="text-white/60 text-xs">de experiencia</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
