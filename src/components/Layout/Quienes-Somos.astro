---
import quienes from "@/img/quienes.jpg";
import { Image, getImage } from "astro:assets";

const imgPreload = await getImage({
  src: quienes,
  widths: [640, 1080, 1920],
  format: "webp",
});
---

<link
  rel="preload"
  as="image"
  href={imgPreload.src}
  imagesrcset={imgPreload.srcSet.attribute}
  imagesizes="(max-width: 768px) 100vw, 50vw"
  fetchpriority="high"
/>

<section
  class="seccion relative min-h-dvh bg-linear-to-br from-slate-100 to-slate-300 p-4 md:p-8 lg:p-12 scroll-mt-20"
  id="quienes-somos"
  aria-labelledby="quienes-title"
>
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"
    aria-hidden="true"
  />

  <div class="relative z-10 container mx-auto max-w-6xl">
    <header class="text-center mb-10 md:mb-16" data-aos="fade-up">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-600 text-xs md:text-sm font-semibold uppercase tracking-[0.15em] mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        Quiénes Somos
      </span>
      <h1
        id="quienes-title"
        class="text-3xl md:text-4xl lg:text-5xl font-black text-slate-900 leading-tight mb-4"
      >
        Más que agentes, somos tus socios en cada decisión inmobiliaria
      </h1>
      <p class="text-base md:text-lg lg:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        15+ años transformando búsquedas en hogares e inversiones rentables con transparencia total
      </p>
    </header>

    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-8 lg:gap-12 items-start">
      <div class="space-y-8" data-aos="fade-right">
        <div class="grid gap-4 md:grid-cols-3" role="list" aria-label="Nuestros pilares">
          <article
            class="group relative p-5 md:p-6 bg-white/60 backdrop-blur-sm rounded-2xl border border-slate-200 hover:border-amber-300 hover:shadow-lg hover:shadow-amber-100 transition-all duration-300"
            role="listitem"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <div class="text-3xl mb-3" aria-hidden="true">🛡️</div>
            <h3 class="font-semibold text-slate-900 mb-1">Transparencia total</h3>
            <p class="text-sm text-slate-600 leading-relaxed">Sin comisiones ocultas, sin sorpresas. Cada paso documentado y comunicado.</p>
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-linear-to-r from-amber-300 to-amber-500 group-hover:w-full transition-all duration-300 rounded-full" aria-hidden="true" />
          </article>

          <article
            class="group relative p-5 md:p-6 bg-white/60 backdrop-blur-sm rounded-2xl border border-slate-200 hover:border-amber-300 hover:shadow-lg hover:shadow-amber-100 transition-all duration-300"
            role="listitem"
            data-aos="fade-up"
            data-aos-delay="180"
          >
            <div class="text-3xl mb-3" aria-hidden="true">🤝</div>
            <h3 class="font-semibold text-slate-900 mb-1">Acompañamiento 360°</h3>
            <p class="text-sm text-slate-600 leading-relaxed">De la primera visita a la firma. Gestión legal, financiera y notarial incluida.</p>
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-linear-to-r from-amber-300 to-amber-500 group-hover:w-full transition-all duration-300 rounded-full" aria-hidden="true" />
          </article>

          <article
            class="group relative p-5 md:p-6 bg-white/60 backdrop-blur-sm rounded-2xl border border-slate-200 hover:border-amber-300 hover:shadow-lg hover:shadow-amber-100 transition-all duration-300"
            role="listitem"
            data-aos="fade-up"
            data-aos-delay="260"
          >
            <div class="text-3xl mb-3" aria-hidden="true">📈</div>
            <h3 class="font-semibold text-slate-900 mb-1">Resultados medibles</h3>
            <p class="text-sm text-slate-600 leading-relaxed">Vendemos/alquilamos en 47 días promedio. Precio real de mercado garantizado.</p>
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-linear-to-r from-amber-300 to-amber-500 group-hover:w-full transition-all duration-300 rounded-full" aria-hidden="true" />
          </article>
        </div>

        <div class="flex flex-wrap gap-3 pt-2 border-t border-slate-200" data-aos="fade-up" data-aos-delay="300">
          <span class="px-4 py-2 bg-white/70 backdrop-blur rounded-full border border-slate-200 text-sm font-medium text-slate-700">+15 años experiencia</span>
          <span class="px-4 py-2 bg-white/70 backdrop-blur rounded-full border border-slate-200 text-sm font-medium text-slate-700">500+ familias atendidas</span>
          <span class="px-4 py-2 bg-white/70 backdrop-blur rounded-full border border-slate-200 text-sm font-medium text-slate-700">98% satisfacción</span>
          <span class="px-4 py-2 bg-white/70 backdrop-blur rounded-full border border-slate-200 text-sm font-medium text-slate-700">Asociados API</span>
        </div>
      </div>

      <div class="relative" data-aos="fade-left" data-aos-delay="150">
        <div class="absolute -inset-4 lg:-inset-6 bg-linear-to-br from-amber-400/20 via-transparent to-amber-500/10 rounded-3xl blur-2xl opacity-60" aria-hidden="true" />

        <div class="relative rounded-2xl overflow-hidden border border-white/50 shadow-2xl shadow-slate-900/10 bg-white">
          <Image
            src={quienes}
            alt="Equipo de Smart House Real Estate asesorando a clientes en oficina"
            widths={[640, 1080, 1300, 1920]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 600px"
            class="w-full h-auto object-cover transition-transform duration-700 hover:scale-[1.015]"
            loading="eager"
            decoding="async"
          />
          <div class="absolute bottom-0 left-0 right-0 h-24 bg-linear-to-t from-slate-900/10 to-transparent pointer-events-none" aria-hidden="true" />
        </div>

        <div class="absolute -bottom-6 -left-6 lg:-bottom-8 lg:-left-8 flex items-center gap-3 bg-white/95 backdrop-blur-md border border-slate-200/50 rounded-2xl px-5 py-4 shadow-xl shadow-slate-900/10 animate-float" data-aos="zoom-in" data-aos-delay="400">
          <div class="w-12 h-12 rounded-xl bg-linear-to-br from-amber-400 to-amber-600 flex items-center justify-center text-white font-bold text-xl">
            15+
          </div>
          <div>
            <p class="text-slate-900 font-bold text-sm md:text-base">Años de experiencia</p>
            <p class="text-slate-500 text-xs md:text-sm">en el sector inmobiliario</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .animate-float { animation: float 4s ease-in-out infinite; }
</style>